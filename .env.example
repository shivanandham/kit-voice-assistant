# College system
KIT_BASE_URL=https://ht.knowvally.com
KIT_PARTICIPANT_KEY=
# LLM
ANTHROPIC_API_KEY=
LLM_MODEL=claude-haiku-5-5
LLM_EFFORT=low
LLM_KEEP_WARM=true
LLM_THINKING=adaptive
HISTORY_WINDOW=20
MODERATION_LLM=true
# Speech
DEEPGRAM_API_KEY=
DG_STT_MODEL=nova-3
DG_TTS_MODEL=aura-2-thalia-en
# Embeddings (RAG)
GEMINI_API_KEY=
EMBED_MODEL=gemini-embedding-001
EMBED_DIM=768
# Storage
DATABASE_URL=postgresql://localhost:5432/kit_assistant
# Documents: context | rag | auto
DOC_MODE=auto
DOC_CONTEXT_TOKEN_BUDGET=60000
DOC_REFRESH_SECONDS=120
# Web
APP_HOST=127.0.0.1
APP_PORT=8000
COOKIE_SECURE=false
PUBLIC_ORIGIN=http://localhost:8000
# classic (frontend/*.html) or app (built React UI in frontend/app/, source in ui/)
UI_VARIANT=classic
# Abuse limits (ABU1-ABU10); defaults shown. IP limits apply to visitors only.
ANON_SESSIONS_PER_HOUR=30
HTTP_LIMIT_PER_MINUTE=120
LOGIN_LIMIT_PER_MINUTE=30
LOGIN_FAILURES_PER_ID=5
LOGIN_FAILURE_WINDOW_SECONDS=900
LIMIT_WS_PER_IP=3
LIMIT_WS_PER_USER=2
LIMIT_WS_TOTAL=40
LIMIT_VISITOR_TURNS_PER_IP_PER_DAY=20
LIMIT_USER_TURNS_PER_DAY=100
LIMIT_UTTERANCE_SECONDS=30
LIMIT_IDLE_SECONDS=180
LIMIT_VISITOR_SOCKET_SECONDS=900
LIMIT_USER_SOCKET_SECONDS=3600
LIMIT_PENDING_PER_CONVERSATION=3
LIMIT_ADMISSIONS_PER_SESSION_PER_DAY=2
LIMIT_ADMISSIONS_PER_IP_PER_DAY=5
LIMIT_TURNS_PER_CONVERSATION=200
LIMIT_DAILY_TURNS=5000
LIMIT_DAILY_TURNS_USERS=8000
LIMIT_TYPED_CHARS=1000
LIMIT_HTTP_BODY_BYTES=65536
LIMIT_WS_MESSAGE_BYTES=8192
LIMIT_AUDIO_FRAME_BYTES=32768
VOICE_GATE_ENABLED=true
LIMIT_VOICE_SECONDS_VISITOR_IP_PER_DAY=900
LIMIT_VOICE_SECONDS_USER_PER_DAY=3600
